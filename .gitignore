# --- AI / ML work ---

# Model weights & checkpoints (keep these out of git — use S3 / a model registry / Git LFS instead)
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.gguf
*.ggml
*.h5
*.hdf5
*.pb
*.tflite
*.pkl
*.pickle
*.joblib
*.npy
*.npz
checkpoints/
models/
weights/
adapter/
merged/
# Includes SentencePiece tokenizer .model files: downloaded artifacts, like weights. Commit small
# ones a test needs under fixtures/ (re-included at the end of this file).
*.model

# Datasets & large data (track with DVC / Git LFS / S3, not git)
data/
datasets/
raw/
processed/
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.jsonl
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
# (Committed sample/fixture data is re-included at the END of this file.)

# ...but not source folders that share names with the model/data ignores above. With
# core.ignorecase=true (the Windows default), `models/` and `data/` would otherwise swallow
# .NET `Models/` (DTOs) and `Data/` (EF DbContext) folders, or a Python `data` subpackage.
# Must come after those patterns: the last matching rule wins.
# src/ is the library shape and the C# layout; app/ and eval/ are the Python Service shape.
!**/src/**/[Mm]odels/
!**/src/**/[Dd]ata/
!**/src/**/[Aa]dapter/
!**/src/**/[Pp]rocessed/
!**/src/**/[Bb]uild/
!**/app/**/[Mm]odels/
!**/app/**/[Dd]ata/
!**/app/**/[Pp]rocessed/
!**/eval/**/[Mm]odels/
!**/eval/**/[Dd]ata/
!**/tests/**/[Mm]odels/
!**/tests/**/[Dd]ata/

# Hugging Face / model & dataset caches
.cache/huggingface/
huggingface/
.torch/
.keras/
transformers_cache/

# Experiment tracking & runs
mlruns/
mlartifacts/
wandb/
runs/
lightning_logs/
outputs/
tb_logs/
tensorboard/
events.out.tfevents.*
catboost_info/
.neptune/
.dvc/cache
.dvc/tmp

# Vector stores / local databases
*.faiss
*.index
chroma/
.chroma/
chromadb/
qdrant_storage/
.lancedb/
*.duckdb
*.sqlite
*.sqlite3
*.db

# Notebook artifacts (strip outputs before committing)
*-checkpoint.ipynb

# Secrets & credentials (NEVER commit — .env is already ignored above)
.env.*
!.env.example
!.env.sample
*.pem
*.key
secrets.*
.aws/
credentials
*.credentials

# --- Local (Docker) & cloud (AWS) infra ---

# Docker
docker-compose.override.yml
.docker/

# Terraform / IaC
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# AWS SAM / CDK / serverless build output
.aws-sam/
cdk.out/
.serverless/

# OS
.DS_Store
Thumbs.db

# Module 12's baked RAG index: a build artifact, rebuilt at image build time
projects/12-aws-deploy/index/

# Mutation and property-testing scratch (R track: mutmut, hypothesis)
mutants/
.hypothesis/

# --- Committed data (keep LAST) ---
# Small sample/fixture data that IS meant to be committed. Each project's shared datasets live
# in projects/<NN>-<name>/fixtures/ (see docs/00). This block must stay at the end: the last
# matching rule wins, so placed earlier, later rules like `outputs/` or `runs/` would re-ignore
# folders inside fixtures/.
!**/sample/**
!**/samples/**
!**/fixtures/**
!**/test_data/**
# The review track's journal is a committed learning record (docs/R-reviewing-ai-written-code.md).
!projects/review-lab/journal/
!projects/review-lab/journal/**
# ...and so are its calibration labels (R track, "Rubric and agreement").
!projects/review-lab/rubric/labels/
!projects/review-lab/rubric/labels/**
