# Normalize text to LF in the repo; check out with the platform's native endings by default.
* text=auto

# Files that run inside Linux containers or shells must stay LF even on a Windows checkout.
*.sh         text eol=lf
Dockerfile   text eol=lf
*.Dockerfile text eol=lf
.dockerignore text eol=lf
*.dockerignore text eol=lf

# Windows-native files.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.sln  text eol=crlf

# Language-aware diffs (hunk headers show the enclosing class/function).
*.cs     text diff=csharp
*.csproj text
*.slnx   text
*.props  text
*.py     text diff=python
*.md     text diff=markdown
*.ipynb  text

# Binary — never touch line endings, never diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.onnx binary
*.dll  binary
*.exe  binary
